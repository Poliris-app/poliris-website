{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": ".*fr.*" }],
      "destination": "/fr/",
      "permanent": false
    },
    { "source": "/", "destination": "/en/", "permanent": false },
    { "source": "/en", "destination": "/en/", "permanent": true },
    { "source": "/fr", "destination": "/fr/", "permanent": true },
    { "source": "/blog/", "destination": "/fr/blog", "permanent": true },
    { "source": "/mentions-legales(/)?", "destination": "/fr/mentions-legales", "permanent": true },
    { "source": "/politique-de-confidentialite(/)?", "destination": "/fr/privacy", "permanent": true },
    { "source": "/tarifs(/)?", "destination": "/fr/pricing", "permanent": true },
    { "source": "/faq(/)?", "destination": "/fr/faqs", "permanent": true },
    { "source": "/services(/)?", "destination": "/fr/", "permanent": true },
    { "source": "/poliris(/)?", "destination": "/fr/", "permanent": true },
    { "source": "/en/poliris(/)?", "destination": "/en/", "permanent": true },
    { "source": "/comparaison-seo-geo(/)?", "destination": "/fr/blog/poliris-comparison", "permanent": true },
    { "source": "/salon-du-search-marketing-lille-2025-quand-lia-et-le-geo-redefinissent-le-business(/)?", "destination": "/fr/blog", "permanent": true },

    { "source": "/visibility(/)?", "destination": "/en/visibility", "permanent": false },
    { "source": "/sentiment(/)?", "destination": "/en/sentiment", "permanent": false },
    { "source": "/technical-audit(/)?", "destination": "/en/technical-audit", "permanent": false },
    { "source": "/content-writing(/)?", "destination": "/en/content-writing", "permanent": false },
    { "source": "/faqs(/)?", "destination": "/en/faqs", "permanent": false },
    { "source": "/glossary(/)?", "destination": "/en/glossary", "permanent": false },
    { "source": "/demo(/)?", "destination": "/en/demo", "permanent": false },
    { "source": "/pricing(/)?", "destination": "/en/pricing", "permanent": false },
    { "source": "/docs(/)?", "destination": "/en/docs", "permanent": false },
    { "source": "/blog", "destination": "/en/blog", "permanent": true },
    { "source": "/blog/:slug", "destination": "/en/blog/:slug", "permanent": true },
    { "source": "/audit/:slug", "destination": "/en/audit/:slug", "permanent": false },

    { "source": "/privacy(/)?", "destination": "/en/privacy", "permanent": false },
    { "source": "/terms(/)?", "destination": "/en/terms", "permanent": false },
    { "source": "/en/docs/implementation(/)?", "destination": "/en/docs/technical-fixes", "permanent": true },
    { "source": "/fr/docs/implementation(/)?", "destination": "/fr/docs/technical-fixes", "permanent": true },
    { "source": "/en/a-propos(/)?", "destination": "/en/docs", "permanent": true },
    { "source": "/a-propos(/)?", "destination": "/fr/docs", "permanent": true },
    { "source": "/en/tarifs(/)?", "destination": "/en/pricing", "permanent": true },
    { "source": "/en/faq(/)?", "destination": "/en/faqs", "permanent": true },
    { "source": "/en/services(/)?", "destination": "/en/", "permanent": true },
    { "source": "/docs/en/:path*(/)?", "destination": "/en/docs", "permanent": true },
    { "source": "/docs/fr/:path*(/)?", "destination": "/fr/docs", "permanent": true },
    { "source": "/en/author/florian(/)?", "destination": "/en/blog", "permanent": true },
    { "source": "/:lang(en|fr)/:path(.+)/", "destination": "/:lang/:path", "permanent": true }
  ],
  "rewrites": [
    { "source": "/en/audit/:path*", "destination": "/en/index.html" },
    { "source": "/fr/audit/:path*", "destination": "/fr/index.html" },
    { "source": "/en/checkout/:path*", "destination": "/en/index.html" },
    { "source": "/fr/checkout/:path*", "destination": "/fr/index.html" }
  ],
  "headers": [
    {
      "source": "/poliris-film/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, indexifembedded" }]
    },
    {
      "source": "/poliris-onboarding-flow-v3.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, indexifembedded" }]
    },
    {
      "source": "/:lang(en|fr)/audit/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/:lang(en|fr)/checkout/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(en|fr)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
